{
  "name": "uninote",
  "productName": "UniNote",
  "version": "1.7.0",
  "description": "AI-powered university notes organiser",
  "author": "choco",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:renderer": "vite build",
    "start": "electron .",
    "smoke": "cross-env UNINOTE_SMOKE=1 electron .",
    "dist": "vite build && electron-builder --win --x64",
    "dist:arm": "vite build && electron-builder --win --arm64"
  },
  "build": {
    "appId": "com.choco.uninote",
    "productName": "UniNote",
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "cashroy",
        "repo": "uninote"
      }
    ],
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": "x64" },
        { "target": "portable", "arch": "x64" }
      ]
    },
    "portable": {
      "artifactName": "UniNote-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "UniNote-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.6.2",
    "mammoth": "^1.11.0",
    "marked": "^15.0.12",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.6",
    "wait-on": "^8.0.3"
  }
}
